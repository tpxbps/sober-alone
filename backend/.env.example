# Required for the playable text-only sample and script creation.
DEEPSEEK_API_KEY=

# Optional providers. Missing keys disable the corresponding capability.
ZHIPUAI_API_KEY=
STEPFUN_API_KEY=
QWEN_API_KEY=
DOUBAO_API_KEY=
MIMO_API_KEY=
HUNYUAN_API_KEY=

# Optional model selection.
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-flash
SCRIPT_EDITOR_MODEL=deepseek-flash

# Local-first defaults. Runtime data stays under backend/.local-data/.
DEBUG=false
# Enable only during an announced one-time recovery window for legacy scripts.
ALLOW_LEGACY_OWNER_CLAIM=false
# DATABASE_URL=sqlite+aiosqlite:///D:/absolute/path/to/game_data.db
# CHROMA_PERSIST_DIR=D:/absolute/path/to/chroma
